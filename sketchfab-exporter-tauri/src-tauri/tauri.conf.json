{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AssetVault",
  "version": "0.1.13",
  "identifier": "com.assetvault.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AssetVault",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "url": "waiting.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["nsis"],
    "externalBin": [],
    "resources": ["sidecar-server", "binaries/node-x86_64-pc-windows-msvc.exe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGRUFBMTgyNEY2QTM2QzcKUldUSE5tcFBncUhxTDhjUm5NUEpTWHdxcDZsYVd2TE5UdDBha2J0dUpmZk9ia3g3aUZrUTI1MGEK",
      "endpoints": ["https://github.com/ARTpace/AssetVault/releases/latest/download/latest.json"],
      "windows": {"installMode": "passive"}
    }
  }
}
