# ============================================================
# apps/assetvault 专属忽略规则
# 说明：本文件原为 AssetVault 仓库根 .gitignore，合仓后基准路径变为
#       apps/assetvault/，所有相对路径均已按新基准书写。
#       通用规则（node_modules、*.log、.env、__pycache__ 等）已上提到仓库根。
# ============================================================

# three.js 是 vendored 的第三方库（Poly Haven 3D 预览用，版本锁定在 0.160.0）。
# 换版本时同步 scripts/build-library.mjs 的解析规则与 test/library-polyhaven-3d-preview.test.js 的存在性断言。
vendor/mviewer/
vendor/three/
!vendor/three/
!vendor/three/**

# 人工草稿与探查脚本：可随时整目录删除，不进版本库
scratch/

# 程序运行期产出（任务库/下载结果/临时备份），可重建
.assetvault/
.sketchvault/
data/
sketchfab-exporter-tauri/src/search-motion.css
downloads/
dist/
artifacts/
示例/
*.lnk

# 依赖外置资源（安装/构建时按需下载）
vendor/blender/
vendor/curl-impersonate/
vendor/browser/

# Tauri 桌面端构建产物与 sidecar
sketchfab-exporter-tauri/src-tauri/sidecar-server/
sketchfab-exporter-tauri/src-tauri/binaries/
sketchfab-exporter-tauri/src-tauri/gen/
sketchfab-exporter-tauri/licensing/

# 构建脚本生成的前端产物
scripts/tmp-*.mjs
sketchfab-exporter-tauri/src/app.js
sketchfab-exporter-tauri/src/engine.js
sketchfab-exporter-tauri/src/gltf-preview.js
sketchfab-exporter-tauri/src/app.css
sketchfab-exporter-tauri/src/index.html
sketchfab-exporter-tauri/src/favicon.svg
sketchfab-exporter-tauri/src/mascot.png
sketchfab-exporter-tauri/src/worker.html
sketchfab-exporter-tauri/src/splash.html
sketchfab-exporter-tauri/src/splash.js
sketchfab-exporter-tauri/src/splash.css

# ── 抓包 / 调试残留（2026-11 基线整理，不入库）──
/c.json
/s.json
/u.json
/v.json
/w.json
/uic.json
/fs.json
/scratch-v.json
/scratch_u.json
/page.html
# 根目录下名为 folder 的 3.6MB ZIP 调试包
/folder
/tmp-fs-diag-out/
/.workbuddy/

# ── Artflow 构建产物拷贝（由 build-library / 打包脚本生成，不入库）──
/sketchfab-exporter-tauri/src/artflow/
/sketchfab-exporter-tauri/src/doc-render.js

# Additional generated viewer bundles (build-library.mjs)
/sketchfab-exporter-tauri/src/image-decoders.js
/sketchfab-exporter-tauri/src/model-thumb.js
/sketchfab-exporter-tauri/src/model-preview.html
/sketchfab-exporter-tauri/src/model-preview.js
