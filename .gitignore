# ============================================================
# 仓库根 .gitignore —— 只放跨应用通用规则
# 各应用的路径相关规则见 apps/<name>/.gitignore
# ============================================================

# ---- 依赖 ----
node_modules/

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志与生成中间物 ----
*.log
scripts/.gen/

# ---- 密钥与本地配置 ----
*.pem
*.key
*.key.pub
.env
.env.*
!.env.example

# ---- Python ----
**/__pycache__/
*.pyc

# ---- Syncthing 冲突副本 ----
*.sync-conflict-*

# ---- 本地隔离区（迁移时移出的大件、归档备份，不入库）----
/_archive/
/_local/
/scratch/
